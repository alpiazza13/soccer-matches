# Football Data API Token
# Get your token from: https://www.football-data.org/
FOOTBALL_DATA_API_TOKEN=your_api_token_here

# Database Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_key

# IMPORTANT: Use the Connection Pool string (Port 6543) for AWS Lambda
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT Configuration
SECRET_KEY=your_secret_key

# Environment Strategy
# Set to 'production' to enable Lambda for async sync, or 'local'/'development' for direct execution
ENV=production

# Lambda Configuration (only used when ENV=production)
# Name of the Lambda function to invoke for database syncs
LAMBDA_FUNCTION_NAME=soccer-match-tracker-sync-worker